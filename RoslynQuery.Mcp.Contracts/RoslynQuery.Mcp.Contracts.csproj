         directly - it's the one TFM both sides already support without a compat shim. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RoslynQuery.Mcp.Contracts</RootNamespace>
  </PropertyGroup>

</Project>

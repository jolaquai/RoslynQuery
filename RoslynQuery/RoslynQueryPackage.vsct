<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidRoslynQueryPackage">
    <Menus>
      <!-- Tools > Roslyn Query -->
      <Menu guid="guidRoslynQueryCmdSet" id="menuRoslynQuery" priority="0x0700" type="Menu">
        <Parent guid="guidRoslynQueryCmdSet" id="groupToolsRoslynQuery" />
        <Strings>
          <ButtonText>Roslyn Query</ButtonText>
          <CommandName>Roslyn Query</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidRoslynQueryCmdSet" id="groupToolsRoslynQuery" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidRoslynQueryCmdSet" id="groupBridge" priority="0x0100">
        <Parent guid="guidRoslynQueryCmdSet" id="menuRoslynQuery" />
      </Group>
    </Groups>

    <Buttons>
      <!-- View > Other Windows > Roslyn Query -->
      <Button guid="guidRoslynQueryCmdSet" id="cmdidShowQueryToolWindow" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="ImageCatalogGuid" id="Search" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Roslyn Query</ButtonText>
        </Strings>
      </Button>

      <!-- View > Other Windows > Reference Graph -->
      <Button guid="guidRoslynQueryCmdSet" id="cmdidShowReferenceGraphToolWindow" priority="0x0101" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="ImageCatalogGuid" id="CallHierarchy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Reference Graph</ButtonText>
        </Strings>
      </Button>

      <!-- Editor context menu, in the group Go To Definition and Find All References live in. -->
      <Button guid="guidRoslynQueryCmdSet" id="cmdidViewReferenceGraph" priority="0x0800" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CODEWIN_NAVIGATETOLOCATION" />
        <Icon guid="ImageCatalogGuid" id="CallHierarchy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>View Reference Graph</ButtonText>
        </Strings>
      </Button>

      <!-- Tools > Roslyn Query > ... : the agent bridge the roslynquery CLI attaches to -->
      <Button guid="guidRoslynQueryCmdSet" id="cmdidBridgeToggle" priority="0x0100" type="Button">
        <Parent guid="guidRoslynQueryCmdSet" id="groupBridge" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Enable Agent Bridge</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidRoslynQueryCmdSet" id="cmdidBridgeRestart" priority="0x0101" type="Button">
        <Parent guid="guidRoslynQueryCmdSet" id="groupBridge" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Restart Agent Bridge</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidRoslynQueryCmdSet" id="cmdidBridgeLog" priority="0x0102" type="Button">
        <Parent guid="guidRoslynQueryCmdSet" id="groupBridge" />
        <Strings>
          <ButtonText>Show Agent Bridge Log</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidRoslynQueryCmdSet" id="cmdidCopyCliPath" priority="0x0103" type="Button">
        <Parent guid="guidRoslynQueryCmdSet" id="groupBridge" />
        <Strings>
          <ButtonText>Copy roslynquery CLI Path</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidRoslynQueryPackage" value="{943e02ac-bfd8-4648-9948-4b7d144f6a2d}" />
    <GuidSymbol name="guidRoslynQueryCmdSet" value="{7acc99ae-d964-461e-94d9-9ef567e60889}">
      <IDSymbol name="cmdidShowQueryToolWindow" value="0x0100" />
      <IDSymbol name="cmdidShowReferenceGraphToolWindow" value="0x0101" />
      <IDSymbol name="cmdidViewReferenceGraph" value="0x0102" />

      <IDSymbol name="menuRoslynQuery" value="0x0200" />
      <IDSymbol name="groupToolsRoslynQuery" value="0x0201" />
      <IDSymbol name="groupBridge" value="0x0202" />
      <IDSymbol name="cmdidBridgeToggle" value="0x0210" />
      <IDSymbol name="cmdidBridgeRestart" value="0x0211" />
      <IDSymbol name="cmdidBridgeLog" value="0x0212" />
      <IDSymbol name="cmdidCopyCliPath" value="0x0213" />
    </GuidSymbol>
  </Symbols>

</CommandTable>

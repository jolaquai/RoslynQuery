<UserControl x:Class="RoslynQuery.ToolWindow.QueryToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             MinWidth="420" MinHeight="220">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Target" Style="{StaticResource Label}" />
            <ComboBox x:Name="TargetCombo" Width="120" Margin="0,0,10,4" SelectionChanged="OnTargetChanged" />

            <TextBlock Text="Scope" Style="{StaticResource Label}" />
            <ComboBox x:Name="ScopeCombo" Width="150" Margin="0,0,10,4" SelectionChanged="OnScopeChanged" />

            <TextBlock Text="Cap" Style="{StaticResource Label}" />
            <ComboBox x:Name="CapCombo" Width="80" Margin="0,0,10,4" />

            <CheckBox x:Name="LiveCheckBox" Content="Live" VerticalAlignment="Center" Margin="0,0,10,4"
                      ToolTip="Re-runs as you type. Disabled for project and solution scope." />
            <CheckBox x:Name="GeneratedCheckBox" Content="Generated" VerticalAlignment="Center" Margin="0,0,10,4"
                      ToolTip="Include .g.cs / .designer.cs and source generated documents." />

            <Button x:Name="RunButton" Content="Run" Width="60" Margin="0,0,6,4" Click="OnRunClick" />
            <Button x:Name="StopButton" Content="Stop" Width="60" Margin="0,0,0,4" IsEnabled="False" Click="OnStopClick" />
        </WrapPanel>

        <TextBlock x:Name="SignatureText" Grid.Row="1" Margin="0,2,0,2" Opacity="0.75" FontFamily="Consolas"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />

        <Border Grid.Row="2" MinHeight="46" MaxHeight="160" Padding="2"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
            <ContentControl x:Name="PredicateHost" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,4,0,4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.85"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFCC4040" Visibility="Collapsed" />
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="4"
                  MouseDoubleClick="OnResultDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Kind" Width="170" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="Text" Width="620" DisplayMemberBinding="{Binding Preview}" />
                    <GridViewColumn Header="Location" Width="220" DisplayMemberBinding="{Binding Location}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>

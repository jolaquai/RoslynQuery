<UserControl x:Class="RoslynQuery.ToolWindow.QueryToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:local="clr-namespace:RoslynQuery.ToolWindow"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             platformui:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static vsshell:VsColors.ToolWindowBackgroundKey}}"
             TextOptions.TextFormattingMode="Display"
             MinWidth="560" MinHeight="220">

    <UserControl.Resources>
        <local:TargetMonikerConverter x:Key="TargetMoniker" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </Style>

        <!-- Flat rows with a subtle fill, no grid lines and no column headers, like Code Search. -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="3" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat, underline-indicator tabs instead of the default Windows tab chrome. -->
        <Style x:Key="FlatTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1" />
                            </Border>

                            <ContentPresenter Grid.Row="1" Margin="0,7,0,0" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <imaging:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top"
                                    Moniker="{Binding Target, Converter={StaticResource TargetMoniker}}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Preview}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    <TextBlock Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Kind, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                        <Run Text="{Binding Location, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CachedPredicateTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <imaging:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top"
                                    Moniker="{Binding Kind, Converter={StaticResource TargetMoniker}}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Display}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="64"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    <TextBlock Text="{Binding Subtitle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReplacementTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Margin="0,2,8,0" VerticalAlignment="Top"
                          IsChecked="{Binding Included, Mode=TwoWay}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Before}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                               TextDecorations="Strikethrough"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                    <TextBlock Text="{Binding After}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    <TextBlock Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Hit.Kind, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                        <Run Text="{Binding Hit.Location, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Warning}" Margin="0,1,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}"
                               Foreground="#FFE0655F" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="140" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="8,8,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Find box: shared by both tabs below, the way a real Find/Replace tool has one "Find what". -->
            <Border Grid.Row="0" MinHeight="24" MaxHeight="120" Padding="6,3" CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBorderKey}}"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
                <ContentControl x:Name="PredicateHost" />
            </Border>

            <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Target" Style="{StaticResource Caption}" Margin="0,0,5,3" />
                    <ComboBox x:Name="TargetCombo" MinWidth="104" Margin="0,0,14,3" VerticalAlignment="Center"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogComboBoxStyleKey}}"
                              SelectionChanged="OnTargetChanged" />

                    <TextBlock Text="Scope" Style="{StaticResource Caption}" Margin="0,0,5,3" />
                    <ComboBox x:Name="ScopeCombo" MinWidth="132" Margin="0,0,14,3" VerticalAlignment="Center"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogComboBoxStyleKey}}" />

                    <TextBlock Text="Cap" Style="{StaticResource Caption}" Margin="0,0,5,3" />
                    <ComboBox x:Name="CapCombo" MinWidth="76" Margin="0,0,14,3" VerticalAlignment="Center"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogComboBoxStyleKey}}" />

                    <CheckBox x:Name="GeneratedCheckBox" Content="Generated" VerticalAlignment="Center" Margin="0,0,14,3"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}"
                              ToolTip="Include .g.cs / .designer.cs and source generated documents." />
                </WrapPanel>

                <Button x:Name="SidebarToggleButton" Grid.Column="1" Content="History &lt;" MinWidth="48" Padding="8,2"
                        VerticalAlignment="Top"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                        Click="OnToggleSidebarClick" ToolTip="Toggle the query history sidebar" />
            </Grid>

            <!-- Describes the Find box above, so it stays visible on both tabs rather than living inside Search's own content. -->
            <TextBlock x:Name="SignatureText" Grid.Row="2" Margin="0,4,0,0" FontFamily="Consolas" Style="{StaticResource Meta}" />

            <TabControl x:Name="MainTabs" Grid.Row="3" Margin="0,7,0,0" Style="{StaticResource FlatTabControl}">
                <TabItem Header="Search" Style="{StaticResource FlatTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RunButton" Content="Run" MinWidth="62" Margin="0,0,6,0" Padding="8,2"
                                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                    Click="OnRunClick" />
                            <Button x:Name="StopButton" Content="Stop" MinWidth="62" Padding="8,2" IsEnabled="False"
                                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                    Click="OnStopClick" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock x:Name="StatusText" Style="{StaticResource Meta}" />
                        </Grid>

                        <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="0,24,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" Foreground="#FFE0655F" />

                        <ListBox x:Name="Results" Grid.Row="2" Margin="0,8,0,0"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource ResultRow}"
                                 ItemTemplate="{StaticResource ResultTemplate}"
                                 MouseDoubleClick="OnResultDoubleClick" />
                    </Grid>
                </TabItem>

                <TabItem Header="Replace" Style="{StaticResource FlatTabItem}">
                    <Grid>
                        <TextBlock x:Name="ReplaceUnavailableText" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Replace isn't available for IOperation matches. Switch Target to SyntaxNode or SyntaxToken."
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />

                        <Grid x:Name="ReplaceBody">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Replace-with box: what each match found by the Find box above is replaced with. -->
                            <Border Grid.Row="0" MinHeight="24" MaxHeight="120" Padding="6,3" CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBorderKey}}"
                                    Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
                                <ContentControl x:Name="ReplacementHost" />
                            </Border>

                            <Grid Grid.Row="1" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Replacement: a string, a SyntaxNode/SyntaxToken, or null to skip a match."
                                           Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="GeneratePreviewButton" Content="Generate Previews" MinWidth="62" Margin="0,0,6,0" Padding="8,2"
                                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                            Click="OnGeneratePreviewClick" />
                                    <!-- Generate Previews re-runs the shared Find query, so it needs the same Stop the Search tab has -
                                         one that's actually reachable without switching tabs mid-run. -->
                                    <Button x:Name="ReplaceStopButton" Content="Stop" MinWidth="62" Margin="0,0,6,0" Padding="8,2" IsEnabled="False"
                                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                            Click="OnStopClick" />
                                    <Button x:Name="ApplySelectedButton" Content="Apply Selected" MinWidth="62" Padding="8,2" IsEnabled="False"
                                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                            Click="OnApplySelectedClick" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ReplaceSignatureText" Grid.Column="0" FontFamily="Consolas" Style="{StaticResource Meta}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SelectAllButton" Content="All" MinWidth="36" Margin="12,0,4,0" Padding="6,1"
                                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                            Click="OnSelectAllClick" ToolTip="Select all previewed replacements" />
                                    <Button x:Name="SelectNoneButton" Content="None" MinWidth="36" Padding="6,1"
                                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                                            Click="OnSelectNoneClick" ToolTip="Deselect all previewed replacements" />
                                    <TextBlock x:Name="ReplaceStatusText" Margin="12,0,0,0" Style="{StaticResource Meta}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="ReplaceErrorText" Grid.Row="2" Margin="0,28,0,0" TextWrapping="Wrap"
                                       Visibility="Collapsed" Foreground="#FFE0655F" />

                            <ListBox x:Name="ReplaceResults" Grid.Row="3" Margin="0,8,0,0"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource ResultRow}"
                                     ItemTemplate="{StaticResource ReplacementTemplate}"
                                     MouseDoubleClick="OnReplaceResultDoubleClick" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}" />

        <Border x:Name="SidebarPane" Grid.Column="2" Margin="4,8,0,0" BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Query History" Style="{StaticResource Caption}" Margin="6,0,0,4" />

                <ListBox x:Name="CachedPredicates" Grid.Row="1"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource ResultRow}"
                         ItemTemplate="{StaticResource CachedPredicateTemplate}"
                         MouseDoubleClick="OnCachedPredicateDoubleClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

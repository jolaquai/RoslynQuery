<UserControl x:Class="RoslynQuery.ToolWindow.ReferenceGraphToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:local="clr-namespace:RoslynQuery.ToolWindow"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             platformui:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static vsshell:VsColors.ToolWindowBackgroundKey}}"
             TextOptions.TextFormattingMode="Display"
             MinWidth="420" MinHeight="200">

    <UserControl.Resources>
        <local:SymbolGlyphMonikerConverter x:Key="GlyphMoniker" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </Style>

        <!-- Applies at every depth: a TreeView hands its ItemContainerStyle down to child items. -->
        <Style x:Key="NodeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="2,1" />
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Moniker="{Binding Glyph, Converter={StaticResource GlyphMoniker}}" />

                <TextBlock local:SignatureText.Parts="{Binding Signature}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />

                <TextBlock Text="{Binding SecondaryText}" Margin="10,0,0,0" Style="{StaticResource Meta}" />

                <TextBlock Text="(recursive)" Margin="10,0,0,0" Style="{StaticResource Meta}"
                           Visibility="{Binding IsRecursive, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="(metadata)" Margin="10,0,0,0" Style="{StaticResource Meta}"
                           Visibility="{Binding IsFromMetadata, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="(searching)" Margin="10,0,0,0" Style="{StaticResource Meta}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Scope" Style="{StaticResource Caption}" Margin="0,0,5,3" />
                <ComboBox x:Name="ScopeCombo" MinWidth="132" Margin="0,0,14,3" VerticalAlignment="Center"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogComboBoxStyleKey}}"
                          SelectionChanged="OnScopeChanged"
                          ToolTip="Narrows the reference branches (Used By, Read By, Assigned By, Instantiated By, Exposed By, Applied To). Uses is always read out of the row's own declaration, and the hierarchy branches search referenced assemblies too." />

            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Content="Refresh" MinWidth="62" Margin="0,0,6,0" Padding="8,2"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                        Click="OnRefreshClick" ToolTip="Re-read every expanded row against the current solution." />
                <Button x:Name="StopButton" Content="Stop" MinWidth="62" Margin="0,0,6,0" Padding="8,2" IsEnabled="False"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                        Click="OnStopClick" ToolTip="Cancels in-flight fetches and clears every expanded row, which may now be stale." />
                <Button x:Name="ClearButton" Content="Clear" MinWidth="62" Padding="8,2"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                        Click="OnClearClick" ToolTip="Drop every root in the list." />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,7,0,0" Style="{StaticResource Meta}" />

        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Foreground="#FFE0655F" />

        <TreeView x:Name="Tree" Grid.Row="3" Margin="0,8,0,0"
                  BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ItemContainerStyle="{StaticResource NodeItem}"
                  ItemTemplate="{StaticResource NodeTemplate}"
                  TreeViewItem.Expanded="OnNodeExpanded"
                  PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                  KeyDown="OnTreeKeyDown" />
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- In-proc VSIX only. devenv is .NET Framework, and VisualStudioWorkspace is unreachable
         from the out-of-proc VisualStudio.Extensibility model, so net472 is not negotiable here. -->
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>RoslynQuery</RootNamespace>
    <AssemblyName>RoslynQuery</AssemblyName>

    <!-- Single source of truth for the extension version: the VSIX manifest is stamped from this
         via |%CurrentProject%;GetVsixVersion| and release.yml derives the release tag from it. -->
    <Version>0.4.0</Version>

    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <DeployExtension Condition="'$(Configuration)' == 'Release'">false</DeployExtension>

    <!-- NU1608: Microsoft.VisualStudio.LanguageServices only publishes up to 4.14.0, pinning
         Microsoft.CodeAnalysis.* to 4.14.0. We compile against 5.6.0 on purpose; devenv redirects
         every one of these to its own 5.7.0.0 at runtime, so the constraint is moot. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="GetVsixVersion" Returns="$(Version)" />

  <ItemGroup>
    <InternalsVisibleTo Include="RoslynQuery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />

    <VSCTCompile Include="RoslynQueryPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>

    <!-- Update, not Include: the SDK already globs .resx. MergeWithCTO folds the compiled .vsct
         into this resource so [ProvideMenuResource("Menus.ctmenu", 1)] can find it. -->
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- MEF v1 attributes: the editor's composition container is System.ComponentModel.Composition. -->
    <Reference Include="System.ComponentModel.Composition" />
    <!-- OleMenuCommandService derives from MenuCommandService, which lives in System.Design. -->
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />

    <!-- Compile-only. VS loads its own Roslyn (5.7.0.0) and devenv.exe.config redirects
         0.0.0.0-5.7.0.0 to it; shipping our copies would duplicate assembly identities and
         break MEF composition. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />

    <!-- Compile-only, same reasoning as the Roslyn packages above: the Verify VSIX payload step in
         release.yml hard-fails on any .dll beyond our own, so shipping a private copy was never an
         option here. VS's own OOP/LSP infrastructure is built on StreamJsonRpc, so devenv already
         has a copy loaded; unverified against a live devenv, since nothing here can launch one. -->
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not a ProjectReference: the Verify VSIX payload step below hard-fails on any .dll
         beyond RoslynQuery.dll itself, so RoslynQuery.Mcp.Contracts.dll can't ship alongside it the
         normal way. Compiling its source directly into this assembly instead still leaves exactly
         one place these types are defined (RoslynQuery.Mcp.Contracts/*.cs) - just two assemblies
         that each compile it, the other being the broker's own unconstrained build. -->
    <Compile Include="..\RoslynQuery.Mcp.Contracts\*.cs" Link="Mcp\Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The broker ships inside this VSIX under Broker/<rid>/, next to RoslynQuery.dll, so
       BrokerProcess.Start finds it on an installed extension and under an F5 experimental instance
       alike. It is a net11 self-contained single-file publish, one per architecture VS 2022+ runs
       on, injected as a VSIX source item rather than shipped as a loose payload assembly - the
       single-file bundle has no loose .dll for "Verify VSIX payload" to trip over. -->
  <PropertyGroup>
    <BrokerProject>$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Broker\RoslynQuery.Mcp.Broker.csproj</BrokerProject>
    <!-- Not $(IntermediateOutputPath): that is set by the SDK targets, which import after this
         PropertyGroup, so it reads empty here. -->
    <BrokerStageDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\broker\</BrokerStageDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Timestamp inputs for PublishBroker's incrementality: a touched broker or Contracts source
         re-triggers the publish, an unchanged tree skips it (a self-contained ASP.NET Core publish
         is slow and ~60-100 MB per RID). -->
    <BrokerSource Include="$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Broker\**\*.cs;$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Broker\*.csproj;$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Contracts\**\*.cs"
                  Exclude="$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Broker\bin\**;$(MSBuildThisFileDirectory)..\RoslynQuery.Mcp.Broker\obj\**" />
  </ItemGroup>

  <Target Name="PublishBroker"
          Inputs="@(BrokerSource)"
          Outputs="$(BrokerStageDir)win-x64\RoslynQuery.Mcp.Broker.exe;$(BrokerStageDir)win-arm64\RoslynQuery.Mcp.Broker.exe">
    <!-- Always Release: the broker is a spawned child process, never debugged in-proc, and a Debug
         self-contained publish is only larger. Needs the .NET 11 SDK on PATH (CI installs it; a dev
         box building the VSIX already has it for the broker project). -->
    <Exec Command="dotnet publish &quot;$(BrokerProject)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(BrokerStageDir)win-x64&quot; --nologo" />
    <Exec Command="dotnet publish &quot;$(BrokerProject)&quot; -c Release -r win-arm64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(BrokerStageDir)win-arm64&quot; --nologo" />
  </Target>

  <Target Name="IncludeBrokerInVsix" AfterTargets="GetVsixSourceItems" DependsOnTargets="PublishBroker">
    <Error Condition="!Exists('$(BrokerStageDir)win-x64\RoslynQuery.Mcp.Broker.exe')"
           Text="PublishBroker did not produce a win-x64 broker exe." />
    <Error Condition="!Exists('$(BrokerStageDir)win-arm64\RoslynQuery.Mcp.Broker.exe')"
           Text="PublishBroker did not produce a win-arm64 broker exe." />
    <ItemGroup>
      <VSIXSourceItem Include="$(BrokerStageDir)win-x64\RoslynQuery.Mcp.Broker.exe">
        <VSIXSubPath>Broker\win-x64</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(BrokerStageDir)win-arm64\RoslynQuery.Mcp.Broker.exe">
        <VSIXSubPath>Broker\win-arm64</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

</Project>

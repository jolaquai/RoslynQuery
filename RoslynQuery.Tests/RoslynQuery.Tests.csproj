<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RoslynQuery.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- .NET 10 SDK dropped the VSTest bridge MTP used to run under, so `dotnet test` errors out
         without this. xunit.v3 builds a self-contained runner exe either way. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- Same NU1608 as RoslynQuery.csproj: LanguageServices pins 4.14.0, we need 5.6.0 for Build. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />

    <!-- RoslynQuery.csproj pulls the VS SDK with ExcludeAssets="runtime" so the VSIX never ships
         devenv's own assemblies. The moniker converters still have to run in-process here, so the
         two the tests actually touch are referenced directly, with runtime assets. -->
    <PackageReference Include="Microsoft.VisualStudio.ImageCatalog" Version="17.14.40260" />
    <PackageReference Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not also RoslynQuery.Mcp.Contracts directly: RoslynQuery.csproj links that project's source
         straight into RoslynQuery.dll (see its own comment on why), so referencing both here would
         put two different assemblies' copies of the same types in scope at once - CS0433. Everything
         Contracts defines is already reachable through this one reference. -->
    <ProjectReference Include="..\RoslynQuery\RoslynQuery.csproj" />
  </ItemGroup>

</Project>
